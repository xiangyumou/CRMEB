includes:
    - phpstan-baseline.neon

# PHP 侧此前没有任何静态分析：只有 `php -l` 和 tests/static 里的手写守卫。
# 那些守卫覆盖的是 phpstan 覆盖不到的东西（事件载荷元数、ORM 关系、前后端路由契约），
# 反过来 phpstan 能抓的类型错误、null 流、未定义变量则完全没人管。
#
# 分析的是镜像里的那份源码（/var/www/crmeb），而不是工作树：应用自身的 vendor 只存在
# 于镜像里，而且"验被测的那个产物"与这个仓库其它门禁的做法一致。
#
# 起步 level 放低并带 baseline：目标是"从今天起不再新增"，而不是一次性清空历史。
# 收紧的办法是调高 level 或缩小 baseline，两者都会让这份配置失败得很明确。
parameters:
    level: 1
    phpVersion: 70433
    paths:
        - /var/www/crmeb/app
        - /var/www/crmeb/crmeb
    scanDirectories:
        - /var/www/crmeb/vendor
    bootstrapFiles:
        - /var/www/crmeb/vendor/autoload.php
    excludePaths:
        analyse:
            # 打包进仓库的第三方 composer path-package。
            - /var/www/crmeb/packages
    # PHP 7.4 上 phpstan 的并行 worker 会偶发段错误，结果因此不稳定。
    # 单进程慢一些，但门禁的结论必须是确定的。
    parallel:
        maximumNumberOfProcesses: 1
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # ThinkPHP 的 facade 是 __callStatic 转发，静态分析看不到方法签名。
        # 这类不是缺陷，放进 baseline 只会把 baseline 变成噪音。
        -
            message: '#^Call to an undefined static method think\\facade\\[A-Za-z]+::#'
        # 同理：门面类的实例方法也通过 __call 转发。
        -
            message: '#^Call to an undefined method think\\(facade|Model|db\\Query)\\?[A-Za-z]*::#'
