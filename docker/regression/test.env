APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
APP_KEY = crmeb-regression

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
HOSTPORT = 3306
USERNAME = root
PASSWORD = regression
DATABASE = crmeb_regression
PREFIX = eb_
CHARSET = utf8mb4
DEBUG = true

[CACHE]
DRIVER = redis
CACHE_PREFIX = regression_
CACHE_TAG_PREFIX = regression_tag_

[REDIS]
REDIS_HOSTNAME = redis
PORT = 6379
REDIS_PASSWORD =
SELECT = 0

[QUEUE]
QUEUE_NAME = regression

# 拆分容器后，Channel 监听地址和客户端连接地址必须分开：
# workerman 容器监听 0.0.0.0，其它容器通过服务名连接它。
[CHANNEL]
LISTEN_IP = 0.0.0.0
CLIENT_IP = workerman
PORT = 40003
