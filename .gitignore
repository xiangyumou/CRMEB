# Dependencies and build output
node_modules/
dist/
.next/
.turbo/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Local settings
.env
.env.local
.idea/
.vscode/
*.iml
.DS_Store
*.log

# Aggregated by `pnpm gen` from per-domain files; never committed, so never conflicted.
*.gen.ts
openapi.json

# The uni-app's own build output
/apps/uni-app/unpackage/
/apps/uni-app/.hbuilderx/

# Local agent tooling
.codex/
.zcode/

# The mini-program's build by-products: Taro's SWC config cache, the bundle module lists
# written by every build (config/bundle-stats.ts), and a developer's own AppID.
/apps/mini/.swc/
/apps/mini/.bundle-stats/
/apps/mini/.env.*.local
