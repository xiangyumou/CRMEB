{
  "name": "@shop/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/kernel/index.ts",
    "./order/ports": "./src/order/ports.ts",
    "./effects": "./src/effects/index.ts",
    "./auth": "./src/auth/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
