          {
            "value": "/pages/points_mall/index"
          }
        ]
      },
      "2": {
        "info": [
          {
            "value": "a"
          },
          {
            "value": "/ok"
          }
        ]
      }
    },
    "expected": {
      "2": {
        "info": [
          {
            "value": "a"
          },
          {
            "value": "/ok"
          }
        ]
      }
    }
  },
  {
    "name": "info-not-array",
    "input": {
      "1": {
        "info": "/pages/points_mall/index"
      }
    },
    "expected": {
      "1": {
        "info": "/pages/points_mall/index"
      }
    }
  },
  {
    "name": "external-http",
    "input": {
