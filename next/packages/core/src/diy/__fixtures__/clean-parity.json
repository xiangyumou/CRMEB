              ]
            }
          ]
        }
      }
    },
    "expected": {
      "1": {
        "name": "menus",
        "menuConfig": {
          "list": [
            {
              "info": [
                {
                  "value": "y"
                },
                {
                  "value": "/keep"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
