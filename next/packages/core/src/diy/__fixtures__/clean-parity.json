      {
        "name": "menus"
      }
    ]
  },
  {
    "name": "value-is-array",
    "input": {
      "1": {
        "value": ["/pages/points_mall/index"]
      }
    },
    "expected": {
      "1": {
        "value": ["/pages/points_mall/index"]
