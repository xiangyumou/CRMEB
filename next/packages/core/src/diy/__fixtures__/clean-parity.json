        "link": "/pages/index/index"
      }
    }
  },
  {
    "name": "url-field",
    "input": {
      "1": {
        "url": "/pages/points_mall/index"
      },
      "2": {
        "url": "/ok"
      }
    },
    "expected": {
      "2": {
        "url": "/ok"
      }
    }
  },
  {
    "name": "value-field",
    "input": {
