[
  {
    "name": "key-removal",
    "input": {
      "pointsMall": [
        {
          "name": "x"
        }
      ],
      "titles": {
        "name": "titles"
      }
    },
    "expected": {
      "titles": {
        "name": "titles"
      }
    }
  },
  {
    "name": "name-removal",
    "input": {
      "1": {
        "name": "seckill",
        "a": 1
      },
      "2": {
        "name": "titles"
      }
    },
    "expected": {
      "2": {
        "name": "titles"
      }
    }
  },
  {
    "name": "link-field",
