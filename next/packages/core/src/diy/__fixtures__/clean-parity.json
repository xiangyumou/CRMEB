      }
    },
    "expected": {
      "1": {
        "inner": {
          "keep": 2
        }
      }
    }
  },
  {
    "name": "empty-object",
    "input": {},
    "expected": {}
  },
  {
    "name": "empty-list",
    "input": [],
    "expected": []
  },
  {
    "name": "scalar-list",
    "input": ["a", "/pages/points_mall/index", "b"],
    "expected": ["a", "/pages/points_mall/index", "b"]
  },
  {
    "name": "mixed-list",
    "input": [
      {
